# i3status configuration file.
# see "man i3status" for documentation.

# It is important that this file is edited as UTF-8.
# The following line should contain a sharp s:
# ß
# If the above line is not correctly displayed, fix your editor first!

general {
        colors = true
        interval = 5
}

# order += "ipv6"
order += "ethernet _first_"
order += "wireless _first_"
order += "battery all"
order += "volume master"
order += "disk /"
order += "load"
order += "cpu_temperature 0"
order += "memory"
order += "tztime local"

battery all {
        format = "%percentage %status" 
        low_threshold = 20
        threshold_type = percentage
        integer_battery_capacity = true
}

cpu_temperature 0 {
	format = "%degreesC"
        path = "/sys/devices/platform/coretemp.0/hwmon/hwmon*/temp1_input"
}

disk "/" {
        format = "%avail DISK"
}

ethernet _first_ {
        format_up = "(%speed) ETH"
        format_down = "down ETH"
        color_bad = "#bbbbbb"
}

load {
        format = "%1min LOAD"
        max_threshold = "1.0"
}

memory {
        format = "%percentage_used RAM"
}

tztime local {
        format = "%Y-%m-%d %H:%M"
}

volume master {
        format = "%volume VOL"
        format_muted = "MUTE VOL"
        device = "default"
}

wireless _first_ {
        format_up = "%quality at %essid"
        format_down = "down WIFI"
}
